{
  "_comment": "Repo-level .claude/settings.json вольта на шаге cut-over: те же события через .claude/bin/hook; на ноутбуке с user-level харнессом шим выходит 0.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/hook session-start", "timeout": 30 }] }],
    "PostToolUse":  [{ "matcher": "Bash|Edit|Write|NotebookEdit|Workflow", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/hook post", "timeout": 60 }] }],
    "PostToolUseFailure": [{ "matcher": "Bash|Edit|Write|NotebookEdit|Workflow", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/hook post", "timeout": 60 }] }],
    "Stop":         [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/hook stop", "timeout": 180 }] }]
  }
}
